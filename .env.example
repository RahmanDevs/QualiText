# QualiText Environment Configuration
# Copy this file to .env for local development. NEVER commit .env or real secrets.

APP_ENV=development
APP_NAME=QualiText
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Auth (Change SECRET_KEY in production! Startup rejects default when APP_ENV=production)
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Enterprise SSO (OIDC / SAML) - Disabled by default
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Corporate SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/sso/callback
OIDC_JWKS_JSON=
OIDC_HS256_SECRET=
OIDC_DEFAULT_WORKSPACE_SLUG=tim-nlp-inti

SAML_ENABLED=false
SAML_IDP_SSO_URL=
SAML_ENTITY_ID=qualitext-sp
SAML_ACS_URL=http://localhost:8000/api/v1/auth/saml/acs
SAML_SHARED_SECRET=

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Database
# Fast-dev default uses local SQLite async; switch to PostgreSQL for full/Docker stack:
# DATABASE_URL=postgresql+asyncpg://qualitext:qualitext@localhost:5432/qualitext
DATABASE_URL=sqlite+aiosqlite:///./qualitext_dev.db

# Object Storage (S3 / MinIO or local filesystem fallback for fast-dev)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.local_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=qualitext-datasets
S3_REGION=us-east-1

# Worker & Queue (Celery + Redis; eager mode runs tasks in-process for fast-dev)
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Embedding Model & Vector Backend (auto detects sentence-transformers/faiss, falls back deterministically)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BACKEND=auto
VECTOR_INDEX_BACKEND=auto

# Observability
OTEL_SERVICE_NAME=qualitext-api

# LLM-as-a-Judge (Placeholder - disabled by default per privacy-first policy)
# Set ALLOW_EXTERNAL_LLM=true ONLY if admin explicitly opts in, or point LLM_BASE_URL to local Ollama/vLLM.
ALLOW_EXTERNAL_LLM=false
LLM_PROVIDER=placeholder
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=

# VLM Verification (PDF page-image vs extracted text/table; disabled by default)
VLM_PROVIDER=placeholder
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=
VLM_MODEL=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LOCALE=id
